# ============================================================
#  remote_bridge — ESP32-S3-N16R8 默认配置
# ============================================================

# ---------- 目标芯片 ----------
CONFIG_IDF_TARGET="esp32s3"

# ---------- Flash: 16MB QIO @80MHz ----------
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---------- PSRAM: 8MB Octal @80MHz (N16R8) ----------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# ---------- 分区表 ----------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---------- 控制台 ----------
# 日志走 UART0 (CH343P)，与 VibeLight 一致：只要线插着就有 COM 口，
# 早期启动/崩溃日志永远抓得到。原生 USB 留给 HID+CDC 协议通道。
CONFIG_ESP_CONSOLE_UART=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ---------- 日志 ----------
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y
CONFIG_LOG_COLORS=n

# ---------- FreeRTOS ----------
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=3072

# ---------- 蓝牙: NimBLE (Central + Observer) ----------
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=8
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_LOG_LEVEL_DEBUG=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
CONFIG_BT_NIMBLE_HS_STOP_TIMEOUT_MS=2000
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# ---------- 性能 ----------
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# ---------- panic ----------
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=n
CONFIG_ESP_SYSTEM_PANIC_SILENT_REBOOT=n

# ---------- 看门狗 ----------
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n

# ---------- USB: TinyUSB 复合设备 (HID 键盘 + HID 消费者 + CDC) ----------
# esp_tinyusb 的类开关是 Kconfig 控制的，编译期决定哪些类被编进来。
#
# 用 Slave/IRQ 模式而不是 DMA：DWC2 控制器在 Buffer DMA 模式下，
# 复合设备（HID + CDC）的端点行为有兼容性问题，表现为 Windows 给
# CDC 接口报 ProblemCode 10（设备起不来），而 HID 接口正常。
CONFIG_TINYUSB_MODE_SLAVE=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_HID_COUNT=2
# 描述符用本项目自定义（多接口复合设备），不用 esp_tinyusb 的单类描述符
CONFIG_TINYUSB_DESC_CUSTOM_VID=n
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=y
# 让 CDC 的行编码变化回调可用
CONFIG_TINYUSB_CDC_EP_BUFSIZE=64
CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=1024
